rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /novels/{novelId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /characters/{characterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
